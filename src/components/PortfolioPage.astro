---
import content from '../data/portfolio.json';
import ProjectScreenshots from './ProjectScreenshots.astro';

interface Props {
  locale: 'pt' | 'en';
}

const { locale } = Astro.props;
const labels = content.labels[locale];
const profile = content.profile;
const featuredProject = content.projects.find((item) => item.featured) ?? content.projects[0];
const technologies = [...new Set(content.projects.flatMap((item) => item.stack))];
const hasContact = Boolean(profile.email || profile.whatsapp || profile.links.github || profile.links.linkedin || profile.links.lattes);
const navigationLabel = labels.navigationLabel;
const languageLabel = labels.languageLabel;
const projectSummaryLabel = `${labels.projectSummaryLabel} ${featuredProject.name}`;
---

<div class="site-shell overflow-hidden">
  <header class="mx-auto flex h-[76px] w-[calc(100%-2rem)] max-w-[1180px] items-center justify-between gap-8 border-b border-line max-[600px]:h-[68px] max-[600px]:gap-2">
    <a class="inline-flex items-center gap-2.5 whitespace-nowrap font-display text-[13px] font-semibold max-[600px]:gap-[7px] max-[600px]:text-[11px]" href="#top" aria-label={labels.homeLabel}>
      <span class="grid size-[27px] place-items-center border border-line font-mono text-xs text-accent max-[600px]:size-6">{profile.name.slice(0, 1).toUpperCase()}</span>
      <span>{profile.name}</span>
    </a>
    <nav class="flex items-center gap-[clamp(20px,4vw,48px)] text-xs text-muted max-[600px]:hidden" aria-label={navigationLabel}>
      <a class="transition-colors hover:text-accent" href="#projects">{labels.navProjects}</a>
      <a class="transition-colors hover:text-accent" href="#experience">{labels.navExperience}</a>
      <a class="transition-colors hover:text-accent" href="#about">{labels.navAbout}</a>
      <a class="transition-colors hover:text-accent" href="#stack">{labels.navStack}</a>
      {hasContact && <a class="transition-colors hover:text-accent" href="#contact">{labels.navContact}</a>}
    </nav>
    <div class="flex items-center gap-3 max-[600px]:gap-2">
      <div class="flex items-center border border-line bg-panel p-[3px]" role="group" aria-label={languageLabel}>
        <a data-locale-link href="/" aria-current={locale === 'pt' ? 'page' : undefined} class:list={["px-2 py-1.5 font-mono text-[10px]", locale === 'pt' ? 'bg-accent text-on-accent' : 'text-muted transition-colors hover:text-ink']}>PT</a>
        <a data-locale-link href="/en/" aria-current={locale === 'en' ? 'page' : undefined} class:list={["px-2 py-1.5 font-mono text-[10px]", locale === 'en' ? 'bg-accent text-on-accent' : 'text-muted transition-colors hover:text-ink']}>EN</a>
      </div>
    </div>
  </header>

  <main id="top">
    <section class="relative mx-auto grid min-h-[620px] w-[calc(100%-2rem)] max-w-[1180px] grid-cols-[1.06fr_.94fr] items-center gap-[70px] py-20 pb-[100px] max-[850px]:min-h-0 max-[850px]:grid-cols-1 max-[850px]:gap-[45px] max-[850px]:pt-[82px] max-[850px]:pb-[100px] max-[600px]:gap-[38px] max-[600px]:pt-[68px]" aria-labelledby="hero-title">
      <div class="max-w-[610px]">
        <p class="mb-[26px] font-mono text-[10px] uppercase tracking-[.11em] text-accent max-[600px]:text-[9px]"><span class="hero-indicator-glow mr-[9px] inline-block size-1.5 rounded-full bg-accent align-[1px]"></span>{labels.heroEyebrow} <span class="text-muted">/ {labels.heroYear}</span></p>
        <p class="mb-[15px] text-[13px] text-muted">{profile.role[locale]}</p>
        <h1 class="m-0 max-w-[650px] font-display text-[clamp(48px,6.5vw,82px)] font-medium leading-[.99] tracking-[-.075em] max-[600px]:text-[clamp(46px,14vw,68px)]" id="hero-title">{profile.headline[locale]}</h1>
        <p class="mt-[26px] max-w-[470px] text-[15px] leading-[1.75] text-muted max-[600px]:text-sm">{profile.intro[locale]}</p>
        <div class="mt-8 flex items-center gap-3">
          <a class="inline-flex min-h-[43px] items-center justify-center gap-3 bg-accent px-4 text-xs font-semibold text-on-accent transition hover:-translate-y-0.5 hover:bg-accent/90" href="#projects">{labels.navProjects}<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 7 17 17M17 7v10H7"/></svg></a>
          {profile.email && <a class="inline-flex min-h-[43px] items-center justify-center gap-3 border border-muted px-4 text-xs font-semibold text-muted transition hover:-translate-y-0.5 hover:border-accent hover:text-ink" href={`mailto:${profile.email}`}>{labels.navContact}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}
        </div>
      </div>

      <div class="relative min-h-[405px] overflow-hidden border border-line bg-panel p-[22px] max-[850px]:w-full max-[850px]:max-w-[520px] max-[850px]:justify-self-end max-[600px]:min-h-[355px] max-[600px]:p-[17px]" role="img" aria-label={projectSummaryLabel}>
        <div class="relative z-10 flex justify-between font-mono text-[9px] tracking-[.06em] text-muted"><span>{labels.projectCode}_01</span><span>{labels.projectTypeCode}</span></div>
        <div class="relative z-10 py-[75px] pl-5 max-[600px]:py-[62px] max-[600px]:pl-2.5"><span class="font-mono text-[10px] text-muted">01 / {String(content.projects.length).padStart(2, '0')}</span><div class="mt-[9px] font-display text-[clamp(60px,8vw,96px)] font-semibold leading-[.95] tracking-[-.09em] text-ink max-[600px]:text-[70px]">{featuredProject.name}<span class="text-accent">.</span></div><div class="mt-3 font-mono text-[10px] tracking-[.2em] text-muted">{featuredProject.kind[locale]}</div></div>
        <div class="relative z-10 grid grid-cols-3 border-y border-line">{featuredProject.stack.slice(0, 3).map((technology, index) => <div class="flex flex-col gap-[7px] border-r border-line px-2.5 py-3.5 last:border-0 max-[600px]:px-1.5 max-[600px]:py-3"><span class="font-mono text-[9px] text-muted">{labels.projectStackCode}_0{index + 1}</span><b class="font-display text-xs font-medium max-[600px]:text-[10px]">{technology}</b></div>)}</div>
        <div class="relative z-10 flex justify-between pt-[15px] font-mono text-[9px] tracking-[.06em] text-muted"><span>{labels.projectFooter}</span><span class="text-sm text-accent">↗</span></div>
        <div class="pointer-events-none absolute -right-[125px] -top-[185px] size-[330px] rounded-full border border-line/70 after:absolute after:inset-[30px] after:rounded-full after:border after:border-line/50"></div>
      </div>

      <a class="absolute bottom-9 left-0 inline-flex items-center gap-[13px] font-mono text-[9px] uppercase tracking-[.08em] text-muted max-[850px]:bottom-[35px]" href="#projects">{labels.scroll}<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" class="text-accent" aria-hidden="true"><path d="M12 5v14m-7-7 7 7 7-7"/></svg></a>
    </section>

    <section class="mx-auto w-[calc(100%-2rem)] max-w-[1180px] border-t border-line py-24 max-[600px]:py-[68px]" id="projects" aria-labelledby="projects-title">
      <div class="mb-[34px] flex items-end justify-between gap-[30px] max-[600px]:mb-[25px]"><div><p class="mb-[14px] font-mono text-[10px] uppercase tracking-[.11em] text-accent">02 — {labels.projectsEyebrow}</p><h2 class="m-0 font-display text-[clamp(30px,4vw,48px)] font-medium leading-[1.05] tracking-[-.055em] max-[600px]:text-[34px]" id="projects-title">{labels.projectsTitle}</h2></div><span class="pb-1.5 font-mono text-[10px] text-muted">{String(content.projects.length).padStart(2, '0')} <i class="text-line not-italic">/</i> {String(content.projects.length).padStart(2, '0')}</span></div>
      <div class="grid grid-cols-2 gap-5 max-[1100px]:grid-cols-1">
        {content.projects.map((item, index) => (
          <article class:list={["border border-line bg-panel", item.featured && 'col-span-2 max-[1100px]:col-span-1']}>
            <div class="flex items-center justify-between gap-5 border-b border-line px-[22px] py-[18px] max-[600px]:px-[15px] max-[600px]:py-[15px]"><span class="font-mono text-[10px] text-muted">{item.kind[locale]}</span>{item.featured && <span class="font-mono text-[9px] uppercase tracking-[.06em] text-accent">{labels.featured}</span>}</div>
            <ProjectScreenshots screenshots={item.screenshots} locale={locale} projectName={item.name} labels={labels} />
            <div class="grid grid-cols-[.8fr_1.2fr] gap-[35px] px-[22px] py-[30px] max-[1100px]:grid-cols-1 max-[1100px]:gap-5 max-[600px]:px-[15px] max-[600px]:py-[24px]">
              <div class="flex items-start gap-[15px]"><span class="pt-2 font-mono text-[10px] text-muted">{String(index + 1).padStart(2, '0')}</span><h3 class="m-0 font-display text-[clamp(34px,4vw,50px)] font-medium leading-none tracking-[-.07em]">{item.name}<span class="text-accent">.</span></h3></div>
              <div><p class="mb-5 max-w-[600px] text-sm leading-[1.75] text-copy max-[600px]:text-[13px]">{item.summary[locale]}</p><ul class="m-0 grid list-none gap-[10px] p-0">{item.highlights[locale].map((highlight) => <li class="grid grid-cols-[18px_1fr] gap-[9px] text-xs leading-[1.6] text-muted"><span class="font-mono text-accent">↳</span>{highlight}</li>)}</ul></div>
            </div>
            <div class="flex items-center justify-between gap-5 border-t border-line px-[22px] py-[18px] max-[600px]:flex-wrap max-[600px]:gap-x-3 max-[600px]:gap-y-2 max-[600px]:px-[15px] max-[600px]:py-3"><div class="flex flex-wrap gap-[7px] max-[600px]:gap-1.5" aria-label={labels.projectTechnologyLabel}>{item.stack.map((technology) => <span class="whitespace-nowrap border border-line px-2 py-1.5 font-mono text-[9px] text-copy max-[600px]:px-1.5 max-[600px]:py-1">{technology}</span>)}</div><div class="flex shrink-0 flex-wrap items-center gap-x-5 gap-y-3 max-[600px]:gap-x-4 max-[600px]:gap-y-1">
              {item.demoUrl && <a class="inline-flex min-h-9 items-center gap-2 bg-accent px-3 text-[10px] font-semibold text-on-accent transition-colors hover:bg-accent/90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={item.demoUrl} target="_blank" rel="noopener noreferrer">{labels.visitDemo}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}
              <div class="flex flex-wrap gap-x-5 gap-y-2" aria-label={labels.projectRepositories}>{item.repositories.map((repository) => <a class="inline-flex min-h-9 items-center gap-[7px] text-[10px] text-copy transition-colors hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={repository.url} target="_blank" rel="noopener noreferrer"><svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.55.1.76-.24.76-.54v-2.08c-3.1.67-3.75-1.31-3.75-1.31-.5-1.28-1.23-1.62-1.23-1.62-1.01-.69.08-.68.08-.68 1.12.08 1.7 1.15 1.7 1.15.99 1.69 2.6 1.2 3.23.92.1-.72.39-1.2.7-1.48-2.48-.28-5.09-1.24-5.09-5.52 0-1.22.44-2.22 1.15-3-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.06 1.15a10.62 10.62 0 0 1 5.57 0c2.12-1.45 3.05-1.15 3.05-1.15.61 1.54.23 2.68.12 2.96.71.78 1.14 1.78 1.14 3 0 4.3-2.62 5.23-5.11 5.51.4.35.75 1.02.75 2.06v3.05c0 .3.2.65.76.54A11.1 11.1 0 0 0 12 .9Z"/></svg>{repository.label}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>)}</div>
            </div></div>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto w-[calc(100%-2rem)] max-w-[1180px] border-t border-line py-24 max-[600px]:py-[68px]" id="experience" aria-labelledby="experience-title">
      <div class="mb-8"><p class="mb-[14px] font-mono text-[10px] uppercase tracking-[.11em] text-accent">03 — {labels.navExperience}</p><h2 class="m-0 font-display text-[clamp(30px,4vw,48px)] font-medium leading-[1.05] tracking-[-.055em] max-[600px]:text-[34px]" id="experience-title">{labels.professionalExperience}</h2></div>
      <div>{content.resume.experience.map((item) => <article class="grid grid-cols-[.45fr_1.55fr] gap-8 border-t border-line py-7 max-[850px]:grid-cols-1 max-[850px]:gap-3 max-[600px]:py-5"><div class="font-mono text-[11px] text-muted">{locale === 'pt' ? item.period : item.periodEn}</div><div><p class="mb-1 font-mono text-[10px] uppercase tracking-[.08em] text-accent">{item.organization[locale]}</p><h3 class="m-0 font-display text-xl font-medium">{item.role[locale]}</h3><ul class="mt-4 grid gap-2 pl-4 text-sm leading-[1.7] text-copy">{item.highlights[locale].map((highlight) => <li>{highlight}</li>)}</ul></div></article>)}</div>
    </section>

    <section class="mx-auto grid w-[calc(100%-2rem)] max-w-[1180px] grid-cols-2 gap-[70px] border-t border-line py-24 max-[850px]:grid-cols-1 max-[850px]:gap-[35px] max-[600px]:py-[68px]" id="about" aria-labelledby="about-title">
      <div><p class="mb-[14px] font-mono text-[10px] uppercase tracking-[.11em] text-accent">04 — {labels.aboutEyebrow}</p><h2 class="m-0 font-display text-[clamp(30px,4vw,48px)] font-medium leading-[1.05] tracking-[-.055em] max-[600px]:text-[34px]" id="about-title">{labels.aboutTitle}</h2><svg class="mt-7 text-accent max-[850px]:hidden" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m7 7 10 10M17 7v10H7"/></svg></div>
      <div class="relative max-w-[520px] pt-5 pl-[30px]"><span class="absolute left-0 top-[-8px] font-display text-5xl leading-none text-accent" aria-hidden="true">“</span><p class="m-0 text-[17px] leading-[1.8] text-copy max-[600px]:text-[15px]">{profile.about[locale]}</p><span class="mt-[27px] inline-block font-mono text-[10px] uppercase tracking-[.08em] text-muted">{profile.location[locale]}</span><div class="mt-7 border-t border-line pt-5"><p class="mb-3 font-mono text-[10px] uppercase tracking-[.1em] text-accent">{labels.languages}</p><ul class="m-0 grid list-none gap-2 p-0 text-xs text-muted">{content.resume.languages.map((item) => <li class="flex flex-wrap justify-between gap-x-5 gap-y-1"><span>{item.name[locale]}</span><span>{item.level[locale]}</span></li>)}</ul></div></div>
    </section>

    <section class="mx-auto w-[calc(100%-2rem)] max-w-[1180px] border-t border-line pt-24 pb-[105px] max-[600px]:py-[68px]" id="stack" aria-labelledby="stack-title">
      <div class="mb-[34px]"><p class="mb-[14px] font-mono text-[10px] uppercase tracking-[.11em] text-accent">05 — {labels.stackEyebrow}</p><h2 class="m-0 font-display text-[clamp(30px,4vw,48px)] font-medium leading-[1.05] tracking-[-.055em] max-[600px]:text-[34px]" id="stack-title">{labels.stackTitle}</h2></div>
      <div class="grid grid-cols-4 border-l border-t border-line max-[850px]:grid-cols-2">{technologies.map((item, index) => <div class="grid min-h-[72px] grid-cols-[28px_1fr_15px] items-center gap-2.5 border-b border-r border-line p-3.5 transition-colors hover:bg-panel max-[600px]:min-h-[62px] max-[600px]:grid-cols-[22px_1fr_13px] max-[600px]:gap-1.5 max-[600px]:p-2.5"><span class="font-mono text-[9px] text-muted">{String(index + 1).padStart(2, '0')}</span><strong class="font-display text-[13px] font-medium max-[600px]:text-[11px]">{item}</strong><svg class="text-muted" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></div>)}</div>
    </section>

    {hasContact && <section class="mx-auto w-[calc(100%-2rem)] max-w-[1180px] border-t border-line py-[75px] pb-[90px] max-[600px]:py-[65px]" id="contact" aria-labelledby="contact-title">
      <p class="mb-[15px] font-mono text-[10px] uppercase tracking-[.11em] text-accent">06 — {labels.contactEyebrow}</p><h2 class="m-0 font-display text-[clamp(30px,4vw,48px)] font-medium leading-[1.05] tracking-[-.055em] max-[600px]:text-[34px]" id="contact-title">{labels.contactTitle}</h2><p class="mb-[27px] mt-[19px] max-w-[450px] text-[13px] leading-[1.7] text-muted">{labels.contactBody}</p>
      <div class="flex flex-wrap items-center gap-6">{profile.email && <a class="inline-flex min-h-[43px] items-center justify-center gap-3 bg-accent px-4 text-xs font-semibold text-on-accent transition hover:-translate-y-0.5 hover:bg-accent/90" href={`mailto:${profile.email}`}><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>{labels.contactButton}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14m-7-7 7 7-7 7"/></svg></a>}{profile.whatsapp && <a class="inline-flex min-h-[43px] items-center justify-center gap-3 border border-muted px-4 text-xs font-semibold text-copy transition hover:-translate-y-0.5 hover:border-accent hover:text-accent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent" href={`https://wa.me/${profile.whatsapp}?text=${encodeURIComponent(labels.whatsappMessage)}`} target="_blank" rel="noopener noreferrer"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M20.4 11.7a8.4 8.4 0 0 1-12.4 7.4L3 20l.9-4.8a8.4 8.4 0 1 1 16.5-3.5Z"/><path d="M8.3 8.2c.2-.5.5-.5.8-.5h.4c.2 0 .4.1.5.4l.7 1.6c.1.3.1.5-.1.7l-.5.6c-.2.2-.2.4 0 .7.6 1 1.4 1.7 2.4 2.2.3.2.5.1.7-.1l.7-.8c.2-.2.4-.3.7-.2l1.5.7c.3.1.4.3.4.5 0 .3-.2 1.1-.7 1.5-.5.5-1.2.7-1.9.6-1.1-.2-2.4-.8-3.8-2-1.2-1.1-2-2.4-2.3-3.4-.3-.9 0-1.8.5-2.5Z"/></svg>{labels.whatsappButton}<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}{profile.links.github && <a class="inline-flex items-center gap-[7px] text-[10px] text-copy transition-colors hover:text-accent" href={profile.links.github} target="_blank" rel="noreferrer"><span aria-hidden="true">⌘</span>{labels.github}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}{profile.links.linkedin && <a class="inline-flex items-center gap-[7px] text-[10px] text-copy transition-colors hover:text-accent" href={profile.links.linkedin} target="_blank" rel="noreferrer">{labels.linkedin}</a>}{profile.links.lattes && <a class="inline-flex items-center gap-[7px] text-[10px] text-copy transition-colors hover:text-accent" href={profile.links.lattes} target="_blank" rel="noreferrer">{labels.lattes}<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg></a>}</div>
    </section>}
  </main>

  <footer class="mx-auto flex min-h-20 w-[calc(100%-2rem)] max-w-[1180px] items-center justify-between gap-5 border-t border-line font-mono text-[9px] text-muted max-[600px]:min-h-[74px] max-[600px]:flex-wrap max-[600px]:py-3.5">
    <a class="inline-flex items-center gap-2.5 font-display text-xs font-semibold text-ink" href="#top"><span class="grid size-[23px] place-items-center border border-line font-mono text-[10px] text-accent">{profile.name.slice(0, 1).toUpperCase()}</span>{profile.name}</a><span class="max-[600px]:order-3 max-[600px]:w-full">{labels.footer}</span><a class="inline-flex items-center gap-[7px] text-[13px] text-accent" href="#top">↑ <span class="text-[9px]">{labels.top}</span></a>
  </footer>
</div>

<button
  data-back-to-top
  class="fixed right-6 bottom-6 z-50 grid size-11 place-items-center border border-line bg-panel text-accent shadow-lg transition hover:border-accent hover:bg-accent hover:text-on-accent focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent max-[600px]:right-4 max-[600px]:bottom-4"
  type="button"
  aria-label={labels.backToTop}
  hidden
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 19V5m-7 7 7-7 7 7" /></svg>
</button>

<article class="resume-print" aria-label={labels.resumeTitle}>
  <header class="resume-header"><div><p class="resume-kicker">{labels.resumeTitle.toUpperCase()}</p><h1>{profile.name}</h1><p>{profile.role[locale]}</p></div><p class="resume-date" data-print-date></p></header>
  <section><h2>{labels.resumeSummarySection}</h2><p>{content.resume.summary[locale]}</p></section>
  {(profile.email || profile.whatsapp || profile.links.github || profile.links.linkedin || profile.links.lattes || profile.location[locale]) && <section><h2>{labels.navContact}</h2><p>{[profile.location[locale], profile.email, profile.whatsapp, profile.links.github, profile.links.linkedin, profile.links.lattes].filter(Boolean).join(' · ')}</p></section>}
  <section><h2>{labels.professionalExperience}</h2>{content.resume.experience.map((item) => <div><h3>{item.role[locale]} — {item.organization[locale]} ({locale === 'pt' ? item.period : item.periodEn})</h3><ul>{item.highlights[locale].map((highlight) => <li>{highlight}</li>)}</ul></div>)}</section>
  <section><h2>{labels.resumeProjects}</h2>{content.projects.map((item) => <div><h3>{item.name} — {item.kind[locale]}</h3><p>{item.summary[locale]}</p><ul>{item.highlights[locale].map((highlight) => <li>{highlight}</li>)}</ul></div>)}</section>
  {content.resume.education.length > 0 && <section><h2>{labels.education}</h2>{content.resume.education.map((item) => <p>{item}</p>)}</section>}
  <section><h2>{labels.skills}</h2><p>{content.resume.skills.join(' · ')}</p></section>
  <section><h2>{labels.languages}</h2><p>{content.resume.languages.map((item) => `${item.name[locale]} — ${item.level[locale]}`).join(' · ')}</p></section>
</article>

<script>
  const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  const updateBackToTopVisibility = () => {
    if (backToTop) backToTop.hidden = window.scrollY < 320;
  };

  window.addEventListener('scroll', updateBackToTopVisibility, { passive: true });
  updateBackToTopVisibility();

  backToTop?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
  });

  document.querySelector<HTMLButtonElement>('[data-print]')?.addEventListener('click', () => {
    const language = document.documentElement.lang === 'pt-BR' ? 'pt-BR' : 'en-US';
    const printDate = document.querySelector<HTMLElement>('[data-print-date]');
    if (printDate) {
      printDate.textContent = new Intl.DateTimeFormat(language, {
        month: 'long',
        year: 'numeric',
      }).format(new Date());
    }
    window.print();
  });
</script>
