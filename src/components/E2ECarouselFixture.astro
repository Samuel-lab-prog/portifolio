---
import ProjectScreenshots from './ProjectScreenshots.astro';
import content from '../data/portfolio.json';
import type { ProjectScreenshot } from '../data/project-media';

interface Props { locale: 'pt' | 'en' }

const { locale } = Astro.props;
const labels = content.labels[locale];

const svgData = (title: string, color: string, width: number, height: number) => {
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${width}" height="${height}" viewBox="0 0 ${width} ${height}"><rect width="100%" height="100%" fill="#0b1220"/><rect x="6%" y="8%" width="88%" height="84%" rx="18" fill="#111b2e" stroke="#27364b" stroke-width="4"/><rect x="10%" y="15%" width="20%" height="70%" rx="8" fill="#1b2940"/><rect x="35%" y="20%" width="52%" height="12%" rx="8" fill="${color}"/><rect x="35%" y="40%" width="40%" height="8%" rx="8" fill="#27364b"/><rect x="35%" y="55%" width="48%" height="8%" rx="8" fill="#27364b"/><text x="50%" y="78%" fill="#f1f5f9" font-family="sans-serif" font-size="${Math.max(20, Math.round(width / 24))}" text-anchor="middle">${title}</text></svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const screenshot = (title: string, color: string, width: number, height: number): ProjectScreenshot => ({
  path: svgData(title, color, width, height),
  width,
  height,
  alt: { pt: `Captura de teste: ${title}`, en: `Test screenshot: ${title}` },
});

const noImages: ProjectScreenshot[] = [];
const oneImage = [screenshot('Single image', '#3b82f6', 1600, 900)];
const carouselOne = [
  screenshot('Dashboard', '#3b82f6', 1600, 900),
  screenshot('Portrait screen', '#60a5fa', 480, 800),
  screenshot('Results', '#2563eb', 1600, 900),
];
const carouselTwo = [
  screenshot('Schedule', '#3b82f6', 1600, 900),
  screenshot('Details', '#60a5fa', 1600, 900),
];

const title = locale === 'pt' ? 'Fixture E2E do carrossel' : 'Carousel E2E fixture';
---

  <main class="mx-auto min-h-screen w-[calc(100%-2rem)] max-w-[1180px] py-8 text-ink">
    <nav class="mb-8 flex gap-4" aria-label={locale === 'pt' ? 'Idioma' : 'Language'}>
      <a class="text-accent underline" href="/e2e-fixture/pt">PT-BR</a>
      <a class="text-accent underline" href="/e2e-fixture/en">EN</a>
    </nav>
    <h1 class="mb-8 font-display text-3xl">{title}</h1>
    <div class="grid grid-cols-2 items-start gap-5 max-[850px]:grid-cols-1">
      <article class="min-w-0 border border-line bg-panel" data-testid="zero-card">
        <h2 class="p-4 font-display text-xl">{locale === 'pt' ? 'Sem imagens' : 'No images'}</h2>
        <ProjectScreenshots screenshots={noImages} locale={locale} projectName="Empty project" labels={labels} />
        <p class="px-4 pb-4 text-copy">{locale === 'pt' ? 'Conteúdo do card permanece disponível.' : 'Card content remains available.'}</p>
      </article>
      <article class="min-w-0 border border-line bg-panel" data-testid="single-card">
        <h2 class="p-4 font-display text-xl">{locale === 'pt' ? 'Uma imagem' : 'One image'}</h2>
        <ProjectScreenshots screenshots={oneImage} locale={locale} projectName="Single project" labels={labels} />
      </article>
      <article class="min-w-0 border border-line bg-panel" data-testid="carousel-one-card">
        <h2 class="p-4 font-display text-xl">{locale === 'pt' ? 'Carrossel um' : 'Carousel one'}</h2>
        <ProjectScreenshots screenshots={carouselOne} locale={locale} projectName="Carousel one" labels={labels} />
      </article>
      <article class="min-w-0 border border-line bg-panel" data-testid="carousel-two-card">
        <h2 class="p-4 font-display text-xl">{locale === 'pt' ? 'Carrossel dois' : 'Carousel two'}</h2>
        <ProjectScreenshots screenshots={carouselTwo} locale={locale} projectName="Carousel two" labels={labels} />
      </article>
    </div>
  </main>
